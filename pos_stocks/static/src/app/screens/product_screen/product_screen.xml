<templates id="template" xml:space="preserve">

    <t t-name="pos_stocks.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ProductCard" position="inside">
            <t t-set-slot="quantityButtons">
                <t t-if="pos.config.wk_display_stock and pos.wkTemplateQtyStr(product)">
                    <span class="qty-tag" t-esc="pos.wkTemplateQtyStr(product)"/>
                    <span t-if="pos.wkTemplateLocation(product)" class="loc-tag" t-esc="pos.wkTemplateLocation(product)"/>
                </t>
            </t>
        </xpath>
    </t>

</templates>
