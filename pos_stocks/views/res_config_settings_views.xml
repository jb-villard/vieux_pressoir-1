<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.stocks</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_inventory_section" position="inside">
                <setting id="pos_stocks" string="Display stock in POS" help="Display product's stock info in POS">
                    <field name="pos_wk_display_stock"/>
                    <div class="content-group" invisible="not pos_wk_display_stock">
                        <div class="row mt16">
                            <label string="Hide out of stock products" for="pos_wk_hide_out_of_stock" class="col-lg-5 o_light_label"/>
                            <field name="pos_wk_hide_out_of_stock"/>
                        </div>
                        <div class="row mt8">
                            <label string="Stock type" for="pos_wk_stock_type" class="col-lg-5 o_light_label"/>
                            <field name="pos_wk_stock_type"/>
                        </div>
                        <div class="row mt8">
                            <label string="Allow Order When Out-of-Stock" for="pos_wk_continous_sale" class="col-lg-5 o_light_label"/>
                            <field name="pos_wk_continous_sale"/>
                        </div>
                        <div class="row mt8" invisible="pos_wk_continous_sale">
                            <label string="Custom message" for="pos_wk_error_msg" class="col-lg-5 o_light_label"/>
                            <field name="pos_wk_error_msg"/>
                        </div>
                        <div class="row mt8" invisible="pos_wk_continous_sale">
                            <label string="Deny order when product stock is lower than" for="pos_wk_deny_val" class="col-lg-5 o_light_label"/>
                            <field name="pos_wk_deny_val"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
