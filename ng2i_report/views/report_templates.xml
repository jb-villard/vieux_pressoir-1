<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Disposition de la société : le titre des factures et devis passe dans l'en-tête.
         Copie de la standard, dont dépendent d'autres rapports d'Odoo (PDF des factures électroniques). -->
    <template id="external_layout_vieux_pressoir" inherit_id="web.external_layout_standard" primary="True">
        <xpath expr="//div[contains(@t-attf-class, 'header o_company')]" position="replace">
            <div t-attf-class="header o_company_#{company.id}_layout">
                <div class="row">
                    <div class="col-9 text-start" style="margin-top:22px;" name="moto">
                        <h2 class="fw-bold">SARL Le Vieux Pressoir</h2>
                    </div>
                </div>
                <div t-if="company.logo or company.report_header" class="row zero_min_height">
                    <div class="col-12">
                        <div style="border-bottom: 1px solid black;"/>
                    </div>
                </div>
                <div class="row" style="padding-top:10px;margin-bottom:20px;">
                    <div class="col-5" name="company_address">
                        <div>81, Avenue de la libération</div>
                        <div>42120 LE COTEAU</div>
                        <div>Tél : 04 77 72 20 75</div>
                        <div>mail: vieuxpressoirlecoteau@orange.fr</div>
                    </div>
                    <div class="col-7" name="title">
                        <h3 t-if="o and (proforma or is_proforma)" class="fw-bold" style="padding-left:10px;" t-out="layout_document_title"/>
                        <h3 t-elif="o and o._name == 'account.move'" class="fw-bold" style="padding-left:10px;">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">FACTURE N° </span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">FACTURE BROUILLON N° </span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">FACTURE ANNULEE N° </span>
                            <span t-if="o.move_type == 'out_refund'">AVOIR N° </span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                            <span t-if="o.name != '/'" t-field="o.name"/>
                        </h3>
                        <h2 t-elif="o and o._name == 'sale.order'" class="fw-bold" style="padding-left:10px;background-color:#28b4ff;color:white;">
                            <span>DEVIS N° </span>
                            <span t-field="o.name"/>
                        </h2>
                    </div>
                </div>
            </div>
        </xpath>
        <!-- Titre masqué mais conservé : l'envoi groupé découpe le PDF sur ce titre -->
        <xpath expr="//h2[@t-out='layout_document_title']" position="attributes">
            <attribute name="t-att-style">'opacity:0;height:0;margin:0;' if o and o._name in ('account.move', 'sale.order') else None</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_content')]" position="replace">
            <div class="o_footer_content text-center" style="border-top: 1px solid black;">
                <ul class="list-inline mb-1">
                    <!-- company_registry passe par le partenaire : l'assistant de mise en page ne l'a pas -->
                    <li t-if="company.partner_id.company_registry" class="list-inline-item d-inline">SIRET: <span t-out="company.partner_id.company_registry"/></li>
                    <li class="list-inline-item d-inline"> Enregistré au RCS de ROANNE</li>
                    <li t-if="company.vat" class="list-inline-item d-inline">TVA : <span t-out="company.vat"/></li>
                    <li>IBAN : FR76 1450 6000 1562 5452 8506 045 - BIC : AGRIFRPP845</li>
                </ul>
                <div name="financial_infos" t-field="company.report_footer"/>
                <div t-if="report_type == 'pdf'" class="text-muted">
                    Page: <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </xpath>
    </template>

    <record id="report_layout_vieux_pressoir" model="report.layout">
        <field name="name">Vieux Pressoir</field>
        <field name="sequence">1</field>
        <field name="view_id" ref="external_layout_vieux_pressoir"/>
    </record>

    <data noupdate="1">
        <record id="base.main_company" model="res.company">
            <field name="external_report_layout_id" ref="external_layout_vieux_pressoir"/>
        </record>
    </data>

    <!-- Facture : montants TTC sur les lignes, pas de colonne taxes -->
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='display_taxes']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
        <xpath expr="//th[@name='th_priceunit']/span" position="replace">
            <span>Prix Unitaire TTC</span>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']/span" position="replace">
            <span>Montant TTC</span>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td name="td_subtotal" class="text-end o_price_total">
                <span t-if="not hide_prices" class="text-nowrap" t-field="line.price_total"/>
            </td>
        </xpath>
    </template>

    <!-- Facture : libellés du bloc des totaux -->
    <template id="document_tax_totals" inherit_id="account.document_tax_totals">
        <xpath expr="//tr[hasclass('o_subtotal')]/td[1]/span" position="replace">
            <span>Montant HT</span>
        </xpath>
        <xpath expr="//tr[hasclass('o_total')]/td[1]/strong" position="replace">
            <strong>Total TTC</strong>
        </xpath>
    </template>

</odoo>
