<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Prix de vente sur les cartes de l'écran de vente, pas sur celles des menus -->
    <t t-name="ng2i_pos.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="after">
            <span t-if="props.priceLabel" class="ng2i-price" t-esc="props.priceLabel"/>
        </xpath>
    </t>

    <t t-name="ng2i_pos.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="priceLabel">getProductPriceLabel(product)</attribute>
        </xpath>
    </t>

</templates>
