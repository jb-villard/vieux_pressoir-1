<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Pied du ticket : adresse et téléphone déjà dans l'en-tête -->
    <t t-name="ng2i_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-config-name')]/following-sibling::div" position="replace"/>
        <xpath expr="//div[@t-if='company.phone']" position="replace"/>
    </t>

</templates>
